# 서버 포트
PORT=3000
# JSON DB 디렉터리 (기본: ./db)
DB_DIR=./db
# LLM 공급자: template(오프라인 규칙 기반) | anthropic
LLM_PROVIDER=template
# anthropic 사용 시
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# YAMNet TF.js 모델 URL (비우면 로컬 /models/yamnet → TF Hub 순으로 시도)
YAMNET_MODEL_URL=
# 규칙 기반 작성기 타이핑 간격(ms)
STREAM_CHUNK_DELAY_MS=22
# 규칙 기반 작성기가 쓰기 전 "생각 중" 시간(ms)
STREAM_THINK_MS=900
