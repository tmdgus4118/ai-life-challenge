{
  "name": "neighbor-sound",
  "version": "1.0.0",
  "description": "이웃소리 - 층간소음 AI 기록·중재 서비스 (2026 AI 라이프 솔루션 챌린지)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "seed": "node src/scripts/seed.js",
    "download-model": "node src/scripts/download-model.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 15000
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "pretendard-gov": "^1.3.9"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
