<nav class="tabbar" aria-label="주요 화면">
  <% const tabs = [
    { key: 'detect', href: '/detect', label: '감지', icon: '<path d="M12 3a4 4 0 0 1 4 4v5a4 4 0 0 1-8 0V7a4 4 0 0 1 4-4z"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>' },
    { key: 'records', href: '/records', label: '기록', icon: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>' },
    { key: 'report', href: '/report', label: '리포트', icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>' },
    { key: 'mediate', href: '/mediate', label: '중재', icon: '<path d="M4 5h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M20 9h1a2 2 0 0 1 2 2v5"/>' },
