<header class="app-header" role="banner">
  <div class="app-header__inner">
    <a class="app-header__brand" href="/" aria-label="이웃소리 홈">
      <img src="/img/icon.svg" alt="" width="28" height="28">
      <span class="app-header__name">이웃소리</span>
      <span class="app-header__sub">층간소음 AI 기록·중재</span>
    </a>
    <h1 class="sr-only"><%= title %></h1>
    <a class="app-header__guide<%= typeof page !== 'undefined' && page === 'guide' ? ' is-active' : '' %>" href="/guide" <%= typeof page !== 'undefined' && page === 'guide' ? 'aria-current="page"' : '' %>>
      <%- icon('scale', 'ico--sm') %>
      <span>법·대응 안내</span>
    </a>
  </div>
</header>
